# Server Configuration
PORT=3000
NODE_ENV="production"
APP_URL="http://localhost:3000"
FRONTEND_URL="https://docconvert-ai-kohl.vercel.app"

# Frontend API URL (Set on Vercel Environment Variables)
VITE_API_URL="https://your-backend-domain.up.railway.app"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key"

# Supabase Auth, PostgreSQL Database & Private Storage
# All authentication, profiles, database tables and private storage buckets ('documents') use Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Azure AI Document Intelligence (Phase 2 - OCR & Layout Extraction)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://your-resource.cognitiveservices.azure.com/"
AZURE_DOCUMENT_INTELLIGENCE_KEY="your_azure_key"

# Maintenance Bridge Configuration (Phase 3B.3.1)
# Set to 'true' to pause new processing confirmations while active jobs drain
PROCESSING_MAINTENANCE_MODE="false"

# Free Credit Bootstrap Policy (Phase 3A.4.2 / Phase 3B.3.7)
# Server-authoritative ISO 8601 timestamp with explicit timezone (Z or +/-HH:mm).
# In production (NODE_ENV=production), system fails closed if missing.
# Users created before this timestamp are considered historical and not eligible for free bootstrap credits.
# Canonical recommended value (matching Phase 3A.3 migration): 2026-10-03T01:00:00.000Z
FREE_BOOTSTRAP_POLICY_EFFECTIVE_AT="2026-10-03T01:00:00.000Z"
